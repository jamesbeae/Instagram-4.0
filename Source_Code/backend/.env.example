NODE_ENV=development
PORT=8000

DATABASE_URL=postgres://postgres:postgres@localhost:5432/Instagram
POSTGRES_PORT=5432
DB_LOGGING=false

ACCESS_TOKEN_CODE=replace-with-a-long-access-secret
REFRESH_TOKEN_CODE=replace-with-a-long-refresh-secret

